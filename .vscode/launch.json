            "console": "internalConsole"
        },
        {
            "name": "Debug Robot",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd",
            "cwd": "${workspaceFolder}",
            "args": [
                "start",
                "--app-name", "origingame-robot",
                "--config", "./config",
                "--pid-dir", "./run",
                "--node", "test-robot-1"
            ],
            "console": "internalConsole"
        }
