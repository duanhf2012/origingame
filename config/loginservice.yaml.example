# 生产部署模板：复制到部署专用配置目录，或由部署系统生成实际 .yaml；本文件不会被 Origin 加载。
services:
  LoginService:
    http:
      server:
        address: "0.0.0.0:8080" # 按实际暴露范围监听；反向代理场景需同时显式配置受信任代理。

    token:
      issuer: "origingame-login" # JWT 签发者，需与 Gateway 校验配置一致。
      audience: "origingame-gateway" # JWT 接收方。
      expire: 24h # 登录 Token 的真实系统时间有效期。
      active_kid: "replace-with-active-kid" # 与 Gateway 的 public_keys 键一致。
      private_key: "${ORIGINGAME_LOGIN_TOKEN_PRIVATE_KEY}" # 由 Secret 注入的 Ed25519 私钥 Seed。

    area:
      refresh_interval: 1m # 每分钟完整刷新区服快照；失败等待下个周期。

    authentication:
      development_passthrough: true # 接入真实平台 SDK 前必须保持 true；接入后替换为经确认的正式配置。

    login_rate_limit:
      enabled: true # 生产默认启用登录请求限流。
      ip:
        enabled: true # 按客户端 IP 限制请求。
        window: 10s # 公共 Redis 滑动窗口时长。
        max_requests: 30 # 单 IP 在窗口内最多登录次数。
      identity:
        enabled: true # 鉴权成功并取得 AccountID 后限制同一账号。
        window: 10s # 公共 Redis 滑动窗口时长。
        max_requests: 5 # 单账号在窗口内最多登录次数。
      concurrency:
        enabled: true # 限制单实例并发登录数。
        max_in_flight: 256 # 在途登录请求硬上限。
